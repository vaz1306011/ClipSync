# Copy this file to `.env` and fill in real values.
# APP_PORT controls both the host-facing port and the port the app listens on
# inside the container — change it here only, docker-compose.yml reads it.
APP_PORT=513

RELAY_KEY=change-this-to-a-long-random-string
APNS_KEY_ID=your-key-id
APNS_TEAM_ID=your-team-id
APNS_BUNDLE_ID=com.sora.clipsync
APNS_PRIVATE_KEY_HOST_PATH=/volume1/docker/clipsync-relay/AuthKey.p8
APNS_USE_SANDBOX=true
