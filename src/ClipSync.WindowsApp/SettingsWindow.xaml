<ui:FluentWindow
    x:Class="ClipSync.WindowsApp.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ClipSync の設定"
    Width="900"
    Height="700"
    MinWidth="720"
    MinHeight="420"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="{DynamicResource SettingsBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GroupHeader" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="2,0,0,8" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SettingsGroup" TargetType="{x:Type Border}">
                <Setter Property="Margin" Value="0,0,0,20" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
            </Style>
            <!-- The first row of a group sets BorderThickness to 0 to drop its divider. -->
            <Style x:Key="SettingsRow" TargetType="{x:Type Border}">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="0,12" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
            </Style>
            <Style x:Key="RowText" TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="RowDescription" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource SettingsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TitleBar Title="ClipSync の設定" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
            <TextBlock Margin="28,8,28,18" Opacity="0.72" Text="ClipSync の動作と接続を設定します。" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="28,0,24,14" TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="166" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,0,12" FontSize="21" FontWeight="SemiBold"
                                       Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                        <Grid>
                            <Border CornerRadius="10" Opacity="0.07" Background="{TemplateBinding Foreground}" />
                            <TabPanel Margin="8" IsItemsHost="True" VerticalAlignment="Top"
                                      KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Padding" Value="13,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Grid Background="Transparent" Margin="0,0,0,4">
                                    <Border x:Name="SelectionFill" CornerRadius="5"
                                            Background="{TemplateBinding Foreground}" Opacity="0" />
                                    <Border x:Name="SelectionOutline" CornerRadius="5"
                                            BorderBrush="{TemplateBinding Foreground}"
                                            BorderThickness="1" Opacity="0" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SelectionFill" Property="Opacity" Value="0.06" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelectionFill" Property="Opacity" Value="0.13" />
                                        <Setter TargetName="SelectionOutline" Property="Opacity" Value="0.50" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="SelectionOutline" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="同期" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="ConnectionStateText" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource RowText}">
                                            <TextBlock Text="接続状態" />
                                            <TextBlock x:Name="ConnectionDetailText" Style="{StaticResource RowDescription}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="SyncPausedBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                         AutomationProperties.Name="クリップボード同期を一時停止する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="クリップボード同期を一時停止する" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource GroupHeader}" Text="アプリ" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <ComboBox x:Name="ThemePicker" DockPanel.Dock="Right" VerticalAlignment="Center" Width="260"
                                                  AutomationProperties.Name="配色テーマ">
                                            <ComboBoxItem Content="ライト" />
                                            <ComboBoxItem Content="ダーク" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="配色テーマ" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="StartOnSignInBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                         AutomationProperties.Name="Windows へのサインイン時に ClipSync を起動する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Windows へのサインイン時に ClipSync を起動する" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="DoubleClickActionPicker" DockPanel.Dock="Right" VerticalAlignment="Center" Width="260" SelectedIndex="0"
                                                  AutomationProperties.Name="トレイアイコンのダブルクリック時の動作">
                                            <ComboBoxItem Content="設定を開く" />
                                            <ComboBoxItem Content="ペアリング QR コードを表示" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="トレイアイコンのダブルクリック時の動作" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="すべての設定をリセット" Click="ResetSettings_Click" />
                                        <StackPanel Style="{StaticResource RowText}">
                                            <TextBlock TextWrapping="Wrap" Text="設定の初期化" />
                                            <TextBlock Style="{StaticResource RowDescription}"
                                                       Text="すべての設定を初期値に戻します。共有キーは変わりません。「適用」または「OK」を押すまで保存されません。" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="接続">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="ペアリング" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="QR コードを表示" Click="ShowPairingQrCode_Click" />
                                        <StackPanel Style="{StaticResource RowText}">
                                            <TextBlock TextWrapping="Wrap" Text="ペアリング QR コード" />
                                            <TextBlock Style="{StaticResource RowDescription}"
                                                       Text="QR コードを使って iPhone と接続します。" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource GroupHeader}" Text="サーバー" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <TextBox x:Name="PortBox" DockPanel.Dock="Right" VerticalAlignment="Center" Width="140" AutomationProperties.Name="ポート番号" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="ポート番号" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Width="320">
                                            <PasswordBox x:Name="MaskedKeyBox" IsEnabled="False" />
                                            <TextBox x:Name="VisibleKeyBox" IsReadOnly="True" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="共有キー" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="ShowKeyBox" DockPanel.Dock="Right" VerticalAlignment="Center" Click="ShowKey_Click"
                                                         AutomationProperties.Name="共有キーを表示" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="共有キーを表示" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="共有キーを再生成" Click="RegenerateKey_Click" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="共有キーの再生成" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="同期">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="クリップボード" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="SyncTextBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                                         AutomationProperties.Name="テキストを同期する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="テキストを同期する" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="SyncImagesBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                                         AutomationProperties.Name="画像を同期する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="画像を同期する" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="SyncFilesBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                                         AutomationProperties.Name="ファイルを同期する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="ファイルを同期する" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource GroupHeader}" Text="ファイル" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <TextBox x:Name="FileLimitBox" DockPanel.Dock="Right" VerticalAlignment="Center" Width="140" AutomationProperties.Name="サイズ上限 (MB、0 は無制限)" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="サイズ上限 (MB、0 は無制限)" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="IgnoreLocalFilesBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                         AutomationProperties.Name="Windowsでコピーしたファイルを送信しない" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Windowsでコピーしたファイルを送信しない" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="認証コード">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="検出" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="DetectOtpBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                                         AutomationProperties.Name="認証コードの検出を有効にする" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="認証コードの検出を有効にする" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <TextBox x:Name="KeywordsBox" DockPanel.Dock="Right" VerticalAlignment="Top" Width="260" Height="100" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="キーワード" />
                                        <StackPanel Style="{StaticResource RowText}">
                                            <TextBlock TextWrapping="Wrap" Text="キーワード" />
                                            <TextBlock Style="{StaticResource RowDescription}"
                                                       Text="1 行に 1 つ" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource GroupHeader}" Text="詳細" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <TextBox x:Name="PatternBox" DockPanel.Dock="Right" VerticalAlignment="Top" Width="260" Height="100" AcceptsReturn="True" MaxLength="4000"
                                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="追加の正規表現" />
                                        <StackPanel Style="{StaticResource RowText}">
                                            <TextBlock TextWrapping="Wrap" Text="追加の正規表現" />
                                            <TextBlock Style="{StaticResource RowDescription}"
                                                       Text="1 行に 1 ルール。上の行から順に試し、最初にコードを取り出せたルールを使います。どれも当てはまらなければ標準の検出を使います。取り出す部分は (?&lt;code&gt;…) か最初の (…) で指定し、省略すると一致した範囲内の 4〜8 桁の数字を使います。" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <TextBlock Text="書き方の例" />
                                        <TextBlock Style="{StaticResource RowDescription}">
                                            <Run FontFamily="Consolas" Text="番号:\s*(?&lt;code&gt;[A-Z0-9]{6})" /><LineBreak />
                                            <Run Text="　「番号: A1B2C3」→ A1B2C3" /><LineBreak />
                                            <Run FontFamily="Consolas" Text="PIN\D*(\d{3})" /><LineBreak />
                                            <Run Text="　「PIN 123」→ 123" /><LineBreak />
                                            <Run FontFamily="Consolas" Text="暗証番号は\d+" /><LineBreak />
                                            <Run Text="　「暗証番号は4567です」→ 4567" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Width="260">
                                            <TextBox x:Name="PatternSampleBox" MaxLength="4000" Text="確認コードは 123456 です。"
                                                     AutomationProperties.Name="テスト用のメッセージ" />
                                            <Button Margin="0,8,0,0" HorizontalAlignment="Right" Content="正規表現をテスト"
                                                    Click="TestPattern_Click" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="テスト用のメッセージ" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="NormalizeOtpBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                                         AutomationProperties.Name="検出前に文字を NFKC 正規化する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="検出前に文字を NFKC 正規化する" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="ExcludeOtpUrlsBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                                         AutomationProperties.Name="検出前に URL を除外する" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="検出前に URL を除外する" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="通知">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="認証コード" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <DockPanel>
                                        <ComboBox x:Name="NotificationModePicker" DockPanel.Dock="Right" VerticalAlignment="Center" Width="260" SelectedIndex="0"
                                                  AutomationProperties.Name="通知方法">
                                            <ComboBoxItem Content="トースト通知" />
                                            <ComboBoxItem Content="入力欄の近くにボタン" />
                                            <ComboBoxItem Content="両方" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="通知方法" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ui:ToggleSwitch x:Name="CopyOtpAutomaticallyBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                         AutomationProperties.Name="通知時にコードを自動コピーする" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="通知時にコードを自動コピーする" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <TextBox x:Name="PopupSecondsBox" DockPanel.Dock="Right" VerticalAlignment="Center" Width="140" AutomationProperties.Name="コードボタンの表示時間 (秒)" />
                                        <TextBlock Style="{StaticResource RowLabel}" Text="コードボタンの表示時間 (秒)" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,14,24,18">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="96" Margin="0,0,8,0" x:Name="ApplyButton" Content="適用" IsEnabled="False" Click="Apply_Click" />
                <ui:Button MinWidth="96" Margin="0,0,8,0" Content="キャンセル" Click="Cancel_Click" />
                <ui:Button MinWidth="96" Content="OK" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
