<ui:FluentWindow
    x:Class="ClipSync.WindowsApp.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ClipSync の設定"
    Width="820"
    Height="700"
    MinWidth="560"
    MinHeight="420"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="{DynamicResource SettingsBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid Background="Transparent" MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckOutline" Width="20" Height="20" Margin="0,0,8,0"
                                        VerticalAlignment="Center" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource SettingsCheckBorderBrush}">
                                    <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,2"
                                          Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckOutline" Property="Background" Value="#0067C0" />
                                    <Setter TargetName="CheckOutline" Property="BorderBrush" Value="#0067C0" />
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckOutline" Property="BorderBrush"
                                            Value="{DynamicResource SettingsCheckHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CheckOutline" Property="BorderBrush"
                                            Value="{DynamicResource SettingsCheckHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource SettingsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TitleBar Title="ClipSync の設定" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
            <TextBlock Margin="28,8,28,18" Opacity="0.72" Text="ClipSync の動作と接続を設定します。" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="28,0,24,14" TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="166" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,0,12" FontSize="21" FontWeight="SemiBold"
                                       Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                        <Grid>
                            <Border CornerRadius="10" Opacity="0.07" Background="{TemplateBinding Foreground}" />
                            <TabPanel Margin="8" IsItemsHost="True" VerticalAlignment="Top"
                                      KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Padding" Value="13,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Grid Background="Transparent" Margin="0,0,0,4">
                                    <Border x:Name="SelectionFill" CornerRadius="5"
                                            Background="{TemplateBinding Foreground}" Opacity="0" />
                                    <Border x:Name="SelectionOutline" CornerRadius="5"
                                            BorderBrush="{TemplateBinding Foreground}"
                                            BorderThickness="1" Opacity="0" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SelectionFill" Property="Opacity" Value="0.06" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelectionFill" Property="Opacity" Value="0.13" />
                                        <Setter TargetName="SelectionOutline" Property="Opacity" Value="0.50" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="SelectionOutline" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="動作" />
                                <DockPanel Margin="0,5">
                                    <ui:ToggleSwitch x:Name="SyncPausedBox" DockPanel.Dock="Right"
                                                     AutomationProperties.Name="クリップボード同期を一時停止する"
                                                     OnContent="オン" OffContent="オフ" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="クリップボード同期を一時停止する" />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="外観" />
                                <ComboBox x:Name="ThemePicker" Width="160" HorizontalAlignment="Left"
                                          AutomationProperties.Name="配色テーマ">
                                    <ComboBoxItem Content="ライト" />
                                    <ComboBoxItem Content="ダーク" />
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="起動" />
                                <CheckBox Margin="0,5" x:Name="StartOnSignInBox" Content="Windows へのサインイン時に ClipSync を起動する" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="同期">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="クリップボード" />
                                <CheckBox Margin="0,5" x:Name="SyncTextBox" Content="テキストを同期する" IsChecked="True" />
                                <CheckBox Margin="0,5" x:Name="SyncImagesBox" Content="画像を同期する" IsChecked="True" />
                                <CheckBox Margin="0,5" x:Name="SyncFilesBox" Content="ファイルを同期する" IsChecked="True" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="ファイル" />
                                <TextBlock Margin="0,3,0,6" Text="サイズ上限 (MB、0 は無制限)" />
                                <TextBox Width="140" HorizontalAlignment="Left" x:Name="FileLimitBox" />
                                <CheckBox Margin="0,12,0,4" x:Name="IgnoreLocalFilesBox" Content="Windowsでコピーしたファイルを送信しない" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="認証コード">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="検出" />
                                <CheckBox Margin="0,5" x:Name="DetectOtpBox" Content="認証コードの検出を有効にする" IsChecked="True" />
                                <TextBlock Margin="0,12,0,5" Text="キーワード (1 行に 1 つ)" />
                                <TextBox Height="100" AcceptsReturn="True" x:Name="KeywordsBox" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="詳細" />
                                <TextBlock Margin="0,3,0,5" Text="追加の正規表現" />
                                <TextBox x:Name="PatternBox" MaxLength="1000" />
                                <TextBlock Margin="0,4,0,0" Opacity="0.72" TextWrapping="Wrap"
                                           Text="取り出す部分は (?&lt;code&gt;…) で指定できます。" />
                                <TextBlock Margin="0,10,0,4" Text="テスト用のメッセージ" />
                                <TextBox x:Name="PatternSampleBox" MaxLength="4000" Text="確認コードは 123456 です。" />
                                <CheckBox Margin="0,10,0,4" x:Name="NormalizeOtpBox" Content="検出前に文字を NFKC 正規化する" IsChecked="True" />
                                <CheckBox Margin="0,4" x:Name="ExcludeOtpUrlsBox" Content="検出前に URL を除外する" IsChecked="True" />
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="正規表現をテスト" Click="TestPattern_Click" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="接続">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="ペアリング" />
                                <TextBlock Margin="0,0,0,10" Opacity="0.72" Text="QR コードを使って iPhone と接続します。" />
                                <Button HorizontalAlignment="Left" Content="QR コードを表示" Click="ShowPairingQrCode_Click" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="サーバー" />
                                <TextBlock Margin="0,3,0,5" Text="ポート番号" />
                                <TextBox Width="140" HorizontalAlignment="Left" x:Name="PortBox" />
                                <TextBlock Margin="0,12,0,5" Text="共有キー" />
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <PasswordBox x:Name="MaskedKeyBox" IsEnabled="False" />
                                    <TextBox x:Name="VisibleKeyBox" IsReadOnly="True" Visibility="Collapsed" />
                                </Grid>
                                <CheckBox Margin="0,10,0,4" x:Name="ShowKeyBox" Content="共有キーを表示" Click="ShowKey_Click" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="共有キーを再生成" Click="RegenerateKey_Click" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="通知">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <ui:Card Margin="0,0,0,14" Background="{DynamicResource SettingsCardBrush}"
                                 BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                            <StackPanel Margin="18">
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="認証コード" />
                                <TextBlock Margin="0,3,0,6" Text="通知方法" />
                                <ComboBox x:Name="NotificationModePicker" Width="300" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Content="トースト通知" />
                                    <ComboBoxItem Content="入力欄の近くにボタン" />
                                    <ComboBoxItem Content="両方" />
                                </ComboBox>
                                <CheckBox Margin="0,12,0,4" x:Name="CopyOtpAutomaticallyBox" Content="通知時にコードを自動コピーする" />
                                <TextBlock Margin="0,12,0,5" Text="コードボタンの表示時間 (秒)" />
                                <TextBox Width="120" HorizontalAlignment="Left" x:Name="PopupSecondsBox" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,14,24,18">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="96" Margin="0,0,8,0" x:Name="ApplyButton" Content="適用" IsEnabled="False" Click="Apply_Click" />
                <ui:Button MinWidth="96" Margin="0,0,8,0" Content="キャンセル" Click="Cancel_Click" />
                <ui:Button MinWidth="96" Content="OK" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
