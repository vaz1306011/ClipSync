<ui:FluentWindow
    x:Class="ClipSync.WindowsApp.QrCodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ClipSync ペアリング QR コード"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="{DynamicResource SettingsBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <StackPanel Background="{DynamicResource SettingsBackgroundBrush}">
        <ui:TitleBar Title="ペアリング QR コード" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <Border Margin="24,8,24,18" Padding="18" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource SettingsCardBrush}"
                BorderBrush="{DynamicResource SettingsCardBorderBrush}">
            <StackPanel>
                <!-- White in both themes: scanners need dark modules on a light field. -->
                <Border HorizontalAlignment="Center" Padding="4" CornerRadius="8" Background="White">
                    <Image x:Name="QrImage" Width="280" Height="280"
                           AutomationProperties.Name="ペアリング QR コード" />
                </Border>
                <TextBlock Margin="0,16,0,0" Opacity="0.72" TextAlignment="Center" TextWrapping="Wrap"
                           Text="ショートカットの「セットアップ」でこの QR コードをスキャンすると、サーバー URL とペアリングキーが自動的に保存されます。" />
            </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,14,24,18">
            <ui:Button HorizontalAlignment="Right" MinWidth="96" Content="閉じる" IsCancel="True" IsDefault="True" />
        </Border>
    </StackPanel>
</ui:FluentWindow>
